[FD.LIUQIN_UEFI]
BaseAddress   = 0xAC000000
Size          = 0x01000000
ErasePolarity = 1
BlockSize     = 0x1000
NumBlocks     = 0x1000

0x00000000|0x00001000
DATA = {
  0x00, 0x04, 0x00, 0x14, 0x1f, 0x20, 0x03, 0xd5,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
