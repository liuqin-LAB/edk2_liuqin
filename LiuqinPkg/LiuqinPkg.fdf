  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
  0x41, 0x52, 0x4d, 0x64, 0x00, 0x00, 0x00, 0x00
}

0x00001000|0x00EFF000
FV = FVMAIN
0x00F00000|0x00100000
DATA = { 0xff }

[FV.FVMAIN]
FvNameGuid         = 2d9b1381-5806-45c4-95bc-35b949efaa25
FvAlignment        = 16
FvForceRebase      = TRUE
ERASE_POLARITY     = 1
MEMORY_MAPPED      = TRUE
STICKY_WRITE       = TRUE
LOCK_CAP           = TRUE
LOCK_STATUS        = TRUE
WRITE_DISABLED_CAP = TRUE
WRITE_ENABLED_CAP  = FALSE
WRITE_STATUS       = FALSE
WRITE_LOCK_CAP     = TRUE
WRITE_LOCK_STATUS  = TRUE
READ_DISABLED_CAP  = TRUE
READ_ENABLED_CAP   = TRUE
READ_STATUS        = TRUE
READ_LOCK_CAP      = TRUE
READ_LOCK_STATUS   = TRUE

