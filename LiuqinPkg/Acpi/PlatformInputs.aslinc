        Device (LID0)
        {
            Name (_HID, "PNP0C0D")
            Name (_UID, Zero)
            Name (_STR, Unicode ("Liuqin cover lid"))
            Name (_STA, 0x0F)
            Name (_DEP, Package () { TLMM })

            Method (_LID, 0, NotSerialized)
            {
                Return (\_SB.TLMM.LRAW)
            }
        }

        Device (SLAT)
        {
            Name (_HID, "LQIN0021")
