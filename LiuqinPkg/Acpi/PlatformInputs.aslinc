            Name (_STR, Unicode ("Liuqin keyboard fold-back mode"))
            Name (_STA, 0x0F)
            Name (_DEP, Package () { TLMM })
            Name (_CRS, ResourceTemplate ()
            {
                GpioInt (Edge, ActiveBoth, Exclusive, PullDefault, 15000,
                         "\\_SB.TLMM", 0, ResourceConsumer, ,) { 23 }
            })
        }

        Device (BTTN)
